          "bgm": "resources/music/gentle_theme.mp3",
          "dialogues": [
            {
              "name": "韩将军",
              "text": "（关切地）苏姑娘，可是迷路了？冷宫方向在那边。",
              "character": "resources/characters/han_general.png",
              "voice": null
            },
            {
              "name": "苏清月",
              "text": "（微微施礼）多谢将军指点。不知将军如何认得我？",
